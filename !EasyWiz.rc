    LTEXT           "In case of existing groups, select from the combo box.\nWhen creating newly, enter in a group name.",
                    IDC_STATIC,33,35,279,18
END

IDD_EASYWIZ_DIALOG2 DIALOG DISCARDABLE  0, 0, 319, 199
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Simple setup wizard (Step 2)"
FONT 8, "MS Sans Serif"
BEGIN
    LTEXT           "Please input one or more domain name server(s) (DNS) to use.",
                    IDC_STATIC,23,20,237,8
    LTEXT           "The mail server detects a SMTP server at the domain name server address.\nIf you do not set this, the transmission to any destination will be impossible.",
