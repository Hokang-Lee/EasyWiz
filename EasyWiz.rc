    LTEXT           "ポート",IDC_STATIC,177,55,19,8
    EDITTEXT        IDC_EDIT_GATEPORT,198,52,22,12,ES_AUTOHSCROLL
    LTEXT           "アーカイブ先IP",IDC_STATIC,46,74,47,9
    EDITTEXT        IDC_EDIT_ARCIP,100,70,74,13,ES_AUTOHSCROLL
    LTEXT           "ポート",IDC_STATIC,177,71,19,8
    EDITTEXT        IDC_EDIT_ARCPORT,198,69,22,13,ES_AUTOHSCROLL
    LTEXT           "メールのコピー先フォルダ名",IDC_STATIC,47,89,125,8
    EDITTEXT        IDC_EDIT_FOLDER,48,102,172,13,ES_AUTOHSCROLL
    PUSHBUTTON      "参照",IDC_BUTTON_FOLDER,226,101,50,14
END

IDD_EASYWIZ_DIALOG8 DIALOG DISCARDABLE  0, 0, 319, 219
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "SPA-PRO Mail Server 簡単セットアップウィザード(ステップ　５)"
FONT 9, "ＭＳ Ｐゴシック"
BEGIN
    LTEXT           "協調動作のための設定を行います。",IDC_STATIC,23,20,106,
