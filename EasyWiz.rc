CAPTION "Simple setup wizard (Step 4)"
FONT 8, "MS Sans Serif"
BEGIN
    LTEXT           "Set the mail address of the postmaster.",IDC_STATIC,23,
                    20,166,8
    LTEXT           "The mail address for a postmaster may be anything except the domain to manage.\nThe entry includes an ""at"" mark, like xxxxxx@xxxx.com.",
                    IDC_STATIC,37,33,260,21
    LTEXT           "Postmaster",IDC_STATIC,39,68,81,8
    EDITTEXT        IDC_EDIT_NAME1,128,65,143,14,ES_AUTOHSCROLL
END

IDD_EASYWIZ_DIALOG5 DIALOG DISCARDABLE  0, 0, 319, 219
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Simple setup wizard (Step 5)"
FONT 8, "MS Sans Serif"
BEGIN
    LTEXT           "Please confirm if the settings are right.\nThe basic setting for the mail server is complete when pressing ""Finish"".\nThe service starts from the 'E-POST Mail Control'.\nPlease use 'E-POST Mail Account manager' for user registration.",
