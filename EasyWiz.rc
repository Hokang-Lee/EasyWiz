                    IDC_STATIC,40,25,158,8
    DEFPUSHBUTTON   "OK",IDOK,178,7,50,14,WS_GROUP
END

IDD_EASYWIZ_DIALOG1 DIALOGEX 0, 0, 320, 200
STYLE DS_MODALFRAME | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_APPWINDOW
CAPTION "SPA-PRO Mail Server 簡単セットアップウィザード(ステップ　1)"
FONT 9, "ＭＳ Ｐゴシック"
BEGIN
    LTEXT           "メールサーバーの設定をナビゲートします。\n",IDC_STATIC,
                    25,21,134,8
    LTEXT           "メールアカウントをどのように管理したいですか？",
                    IDC_STATIC,25,47,142,8
    CONTROL         "複数のドメインでアカウントを管理したい。",
                    IDC_RADIO_SEL1,"Button",BS_AUTORADIOBUTTON | WS_GROUP,34,
                    68,134,10
    CONTROL         "WINDOWSのローカルアカウントと連携させたい。",
                    IDC_RADIO_SEL2,"Button",BS_AUTORADIOBUTTON,34,81,154,10
    CONTROL         "WINDOWSのアクティブディレクトリ(AD)のアカウントと連携させたい。",
                    IDC_RADIO_SEL3,"Button",BS_AUTORADIOBUTTON,34,94,211,10
    LTEXT           "注意）　本ウィザードで設定された内容は「完了」ボタンを押すと既存の設定を「上書き」します。\n　　　　　設定済みの場合は「キャンセル」ボタンを押して終了させて下さい。",
                    IDC_STATIC,30,133,274,23
END

IDD_EASYWIZ_DIALOG11 DIALOG DISCARDABLE  0, 0, 319, 199
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "SPA-PRO Mail Server 簡単セットアップウィザード(ステップ　1-1)"
FONT 9, "ＭＳ Ｐゴシック"
BEGIN
    LTEXT           "メールグループを設定してください。",IDC_STATIC,23,20,
                    103,8
    LTEXT           "メールグループ",IDC_STATIC,34,70,46,8
    COMBOBOX        IDC_COMBO_LOCALGROUP,126,67,108,84,CBS_DROPDOWN | 
                    CBS_SORT | WS_VSCROLL | WS_TABSTOP
    LTEXT           "既存のグループをメールグループとする時はコンボボックスの一覧から選択してください。\nメールグループを新規作成する場合はそのままグループ名を入力してください。",
                    IDC_STATIC,33,35,279,21
END

IDD_EASYWIZ_DIALOG12 DIALOG DISCARDABLE  0, 0, 319, 199
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "SPA-PRO Mail Server 簡単セットアップウィザード(ステップ　1-2)"
FONT 9, "ＭＳ Ｐゴシック"
BEGIN
    LTEXT           "接続するアクティブディレクトリ(AD)名とメールグループを設定してください。",
                    IDC_STATIC,25,21,217,8
    LTEXT           "アクティブディレクトリ(AD)名",IDC_STATIC,37,69,83,8
    EDITTEXT        IDC_EDIT_ADNAME,128,67,106,13,ES_AUTOHSCROLL
    LTEXT           "メールグループ",IDC_STATIC,37,97,46,8
    COMBOBOX        IDC_COMBO_LOCALGROUP,128,93,108,81,CBS_DROPDOWN | 
                    CBS_SORT | WS_VSCROLL | WS_TABSTOP
    LTEXT           "既存のグループをメールグループとする時はコンボボックスの一覧から選択してください。\nメールグループを新規作成する場合はそのままクループ名を入力してください。",
                    IDC_STATIC,33,35,279,21
END

IDD_EASYWIZ_DIALOG2 DIALOG DISCARDABLE  0, 0, 319, 199
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "SPA-PRO Mail Server 簡単セットアップウィザード(ステップ　2)"
FONT 9, "ＭＳ Ｐゴシック"
BEGIN
    LTEXT           "使用するドメインネームサーバー(DNS)を１つ以上設定します。",
                    IDC_STATIC,23,20,180,8
    LTEXT           "ドメインネームサーバーの情報でメールサーバは送り先のSMTPサーバーを検出しています。\n本設定を行わない場合、目的地への送信が不可能となるサイトが発生します。",
                    IDC_STATIC,33,35,279,21
    LTEXT           "ＩＰアドレス (例 192.168.0.1)",IDC_STATIC,84,65,78,8
    LTEXT           "DNS1",IDC_STATIC,38,79,18,8
    EDITTEXT        IDC_EDIT_DNS1,67,79,116,13,ES_AUTOHSCROLL
    LTEXT           "DNS2",IDC_STATIC,38,99,18,8
    EDITTEXT        IDC_EDIT_DNS2,67,97,116,13,ES_AUTOHSCROLL
    LTEXT           "DNS3",IDC_STATIC,38,119,18,8
    EDITTEXT        IDC_EDIT_DNS3,67,115,116,13,ES_AUTOHSCROLL
END

IDD_EASYWIZ_DIALOG3 DIALOG DISCARDABLE  0, 0, 319, 199
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "SPA-PRO Mail Server 簡単セットアップウィザード(ステップ　3)"
FONT 9, "ＭＳ Ｐゴシック"
BEGIN
    LTEXT           "管理するドメイン名と接続するIPアドレスを設定してください。",
                    IDC_STATIC,23,20,172,8
    LTEXT           "NAT内で設定しているメールサーバーはサーバーに割当てた、ローカルＩＰアドレスを設定して下さい。",
                    IDC_STATIC,30,33,255,19
    LTEXT           "ドメイン名 ( 例. xxxx.co.jp )",IDC_STATIC,93,57,79,8
    LTEXT           "ＩＰアドレス (例 192.168.0.1)",IDC_STATIC,206,57,78,8
    LTEXT           "１：",IDC_STATIC1,39,73,9,8
    EDITTEXT        IDC_EDIT_NAME1,81,70,105,14,ES_AUTOHSCROLL
    EDITTEXT        IDC_EDIT_IP1,201,70,92,13,ES_AUTOHSCROLL
    LTEXT           "２：",IDC_STATIC2,39,93,9,8
    EDITTEXT        IDC_EDIT_NAME2,81,90,105,14,ES_AUTOHSCROLL
    EDITTEXT        IDC_EDIT_IP2,201,90,92,13,ES_AUTOHSCROLL
    LTEXT           "３：",IDC_STATIC3,39,113,9,8
    EDITTEXT        IDC_EDIT_NAME3,81,110,105,14,ES_AUTOHSCROLL
    EDITTEXT        IDC_EDIT_IP3,201,110,92,13,ES_AUTOHSCROLL
END

IDD_EASYWIZ_DIALOG4 DIALOG DISCARDABLE  0, 0, 319, 201
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "SPA-PRO Mail Server 簡単セットアップウィザード(ステップ　4)"
FONT 9, "ＭＳ Ｐゴシック"
BEGIN
    LTEXT           "管理者とするメールアドレスを設定します。",IDC_STATIC,23,
                    20,123,8
    LTEXT           "管理者とするメールアドレスはドメイン外のメールアドレスでも構いません。\n設定は、 xxxxxx@xxxx.co.jp のように@マーク以降のドメインも設定して下さい。",
                    IDC_STATIC,37,33,260,26
    LTEXT           "管理者とするメールアドレス",IDC_STATIC,39,68,81,8
    EDITTEXT        IDC_EDIT_NAME1,128,65,143,14,ES_AUTOHSCROLL
END

IDD_EASYWIZ_DIALOG5 DIALOG DISCARDABLE  0, 0, 319, 219
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "SPA-PRO Mail Server 簡単セットアップウィザード(ステップ　5)"
FONT 9, "ＭＳ Ｐゴシック"
BEGIN
    LTEXT           "内容が正しければ、「完了」ボタンを押すとメールサーバーの基本設定は終了です。\nサービス開始は、コントロールダイアログより行ってください。\nユーザー登録は、ユーザーマネージャーより行ってください。",
                    IDC_STATIC_S5,25,20,273,26
    LTEXT           "以下の条件で設定を行います。",IDC_STATIC,25,51,92,8
    EDITTEXT        IDC_STATIC_SETUPLIST,25,69,279,136,ES_MULTILINE | 
                    ES_AUTOVSCROLL | ES_READONLY | WS_VSCROLL
END

IDD_EASYWIZ_DIALOG6 DIALOG DISCARDABLE  0, 0, 319, 219
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "SPA-PRO Mail Server 簡単セットアップウィザード(ステップ　５)"
FONT 9, "ＭＳ Ｐゴシック"
BEGIN
    LTEXT           "経由したメールをアーカイブする設定を行います。",
                    IDC_STATIC,23,20,144,8
    LTEXT           "ＳＭＴＰサーバーを通過した全メールの内容を残したい場合に任意のメールアドレス宛に内容を送りメールボックスに保管することが出来ます。",
                    IDC_STATIC,37,33,260,26
    LTEXT           "アーカイブ先のメールアドレス",IDC_STATIC,39,68,87,8
    EDITTEXT        IDC_EDIT_EMAIL,128,65,143,14,ES_AUTOHSCROLL
END

IDD_EASYWIZ_DIALOG7 DIALOG DISCARDABLE  0, 0, 319, 219
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "SPA-PRO Mail Server 簡単セットアップウィザード(ステップ　６)"
FONT 9, "ＭＳ Ｐゴシック"
BEGIN
    LTEXT           "SMTP ゲートウェイとして使用しますか？",IDC_STATIC,25,21,
