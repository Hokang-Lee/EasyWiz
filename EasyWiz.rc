    LTEXT           "DNS2",IDC_STATIC,38,118,24,8
    EDITTEXT        IDC_EDIT_DNS2,73,114,116,13,ES_AUTOHSCROLL
    LTEXT           "DNS3",IDC_STATIC,38,137,24,8
    EDITTEXT        IDC_EDIT_DNS3,73,132,116,13,ES_AUTOHSCROLL
END

IDD_EASYWIZ_DIALOG3 DIALOG DISCARDABLE  0, 0, 319, 199
