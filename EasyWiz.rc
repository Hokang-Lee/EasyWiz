CAPTION "Simple setup wizard (Step 3)"
FONT 8, "MS Sans Serif"
BEGIN
    LTEXT           "Input the IP address(es) which connect with the domain name to manage.",
                    IDC_STATIC,23,20,229,8
    LTEXT           "When connecting via NAT, input the local IP address.",
                    IDC_STATIC,30,33,183,8
    LTEXT           "Domain Name (eg. xxxx.com )",IDC_STATIC,81,57,101,8
    LTEXT           "IP Address (eg. 192.168.0.1)",IDC_STATIC,201,57,97,8
    LTEXT           "1:",IDC_STATIC1,39,73,9,8
