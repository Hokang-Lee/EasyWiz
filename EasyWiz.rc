BEGIN
    ICON            IDR_MAINFRAME,IDC_STATIC,11,17,20,20
    LTEXT           "EasyWiz Version 1.00",IDC_STATIC,40,10,119,8,
                    SS_NOPREFIX
    LTEXT           "Copyright 2003-2007 e-POST Inc. All rights reserved.",
                    IDC_STATIC,40,25,170,8
