IDD_EASYWIZ_DIALOG1 DIALOGEX 0, 0, 320, 200
STYLE DS_MODALFRAME | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_APPWINDOW
CAPTION "E-POST Mail Server Simple setup wizard (Step 1)"
FONT 8, "MS Sans Serif", 0, 0, 0x1
BEGIN
    LTEXT           "E-POST Mail Server navigation setup.",IDC_STATIC,25,21,
                    193,8
    LTEXT           "What kind of mail account do you want to manage?",
                    IDC_STATIC,25,47,214,8
    CONTROL         "Multi-Domain",IDC_RADIO_SEL1,"Button",
                    BS_AUTORADIOBUTTON | WS_GROUP,34,68,134,10
    CONTROL         "A local account of WINDOWS",IDC_RADIO_SEL2,"Button",
                    BS_AUTORADIOBUTTON,34,81,154,10
    CONTROL         "Active Directory (AD) account of WINDOWS",
                    IDC_RADIO_SEL3,"Button",BS_AUTORADIOBUTTON,34,94,211,10
    LTEXT           "(note )\nThis wizard will OVERWRITE any existing settings if you press ""Finish"".\nPlease press  ""Cancel"" now if you want to backup old settings.",
                    IDC_STATIC,30,133,242,34
END

IDD_EASYWIZ_DIALOG11 DIALOG DISCARDABLE  0, 0, 319, 199
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Simple setup wizard (Step 1-1)"
FONT 8, "MS Sans Serif"
BEGIN
    LTEXT           "Input a Mail Group.",IDC_STATIC,23,20,103,8
    LTEXT           "Mail Group",IDC_STATIC,34,70,46,8
    COMBOBOX        IDC_COMBO_LOCALGROUP,126,67,108,84,CBS_DROPDOWN | 
                    CBS_SORT | WS_VSCROLL | WS_TABSTOP
    LTEXT           "In case of existing groups, select from the combo box.\nWhen creating newly, input a group name.",
                    IDC_STATIC,33,35,279,18
END

IDD_EASYWIZ_DIALOG12 DIALOG DISCARDABLE  0, 0, 319, 199
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Simple setup wizard (Step 1-2)"
FONT 8, "MS Sans Serif"
BEGIN
    LTEXT           "Input the Active Directory (AD) name and a mail group to use.",
                    IDC_STATIC,25,21,249,8
    LTEXT           "Active Directory(AD)",IDC_STATIC,37,69,83,8
    EDITTEXT        IDC_EDIT_ADNAME,128,67,106,13,ES_AUTOHSCROLL
    LTEXT           "Mail Group",IDC_STATIC,37,97,46,8
    COMBOBOX        IDC_COMBO_LOCALGROUP,128,93,108,81,CBS_DROPDOWN | 
                    CBS_SORT | WS_VSCROLL | WS_TABSTOP
    LTEXT           "In case of existing groups, select from the combo box.\nWhen creating newly, input a group name.",
                    IDC_STATIC,33,35,279,18
END

IDD_EASYWIZ_DIALOG2 DIALOG DISCARDABLE  0, 0, 319, 199
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Simple setup wizard (Step 2)"
FONT 8, "MS Sans Serif"
BEGIN
    LTEXT           "Please input one or more domain name server(s) (DNS) to use.",
                    IDC_STATIC,23,20,237,8
    LTEXT           "The mail server detects a SMTP server at the domain name server address.\nIf you do not set this, the transmission to any destination will be impossible.",
                    IDC_STATIC,27,33,285,36
    LTEXT           "IP Address (eg. 192.168.0.1)",IDC_STATIC,84,82,99,8
    LTEXT           "DNS1",IDC_STATIC,38,99,24,8
